# Copy this to secrets.toml for local testing
# For Streamlit Cloud, add these in the dashboard under Settings > Secrets

# ============================================
# LLM CONFIGURATION (choose one or more)
# ============================================

# Option 1: Groq (RECOMMENDED - free, fast, high quality)
# Get your free API key at https://console.groq.com
GROQ_API_KEY = "gsk_your-groq-api-key"
GROQ_MODEL = "llama-3.1-8b-instant"  # or "llama-3.3-70b-versatile", "mixtral-8x7b-32768"

# Option 2: OpenAI (paid)
OPENAI_API_KEY = "sk-your-openai-key"

# ============================================
# AUTHENTICATION (Required)
# ============================================
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "your-supabase-anon-key"

# Optional: Google OAuth (if configured in Supabase)
# GOOGLE_CLIENT_ID = "your-google-client-id"
# GOOGLE_CLIENT_SECRET = "your-google-client-secret"
